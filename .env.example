# Copy to .env.local for local development (`cp .env.example .env.local`) and fill
# in the empty values. .env.local is git-ignored; never commit real secrets.
# In production the same variables are set in Coolify. All are read at runtime.

# Hosted Supabase project (buzz-poc). The URL and publishable key are public and
# are also handed to the browser.
SUPABASE_URL=https://sfyaiqceptuzdgxvpksh.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_XBOlF9wKAAfKbRqOw0tVZw_aTB2FkFH

# Supabase secret key (sb_secret_...). Server and worker only.
# Dashboard -> Project Settings -> API Keys -> secret key.
SUPABASE_SECRET_KEY=

# Redis for the BullMQ queue. This points at the docker-compose Redis
# (`docker compose up -d`). Production uses the Coolify-internal URL.
REDIS_URL=redis://localhost:6379

# Telegram bot token from @BotFather. Worker only.
TELEGRAM_BOT_TOKEN=

# Id of the Telegram chat the worker posts to. Worker only.
TELEGRAM_CHAT_ID=
