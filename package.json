{
  "name": "buzz-poc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev:all": "node scripts/check-env-local.mjs",
    "dev:all": "concurrently -n web,worker -c cyan,magenta \"npm:dev\" \"npm:worker:dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "worker": "tsx --env-file-if-exists=.env.local worker/index.ts",
    "worker:dev": "tsx watch --env-file-if-exists=.env.local --include=.env.local worker/index.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bullmq": "^6.4.0",
    "ioredis": "^6.0.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
